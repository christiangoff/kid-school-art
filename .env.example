# Where the database and uploaded art are stored. Defaults to ./data.
# DATA_DIR=./data

# The address people use to reach the app. Used in invite links, and turns on
# HTTPS-only cookies when it starts with https://.
# APP_URL=http://raspberrypi.local:3000

# Let anyone create an account. Off by default once the first account exists,
# so new people need an invite.
# ALLOW_SIGNUP=false
